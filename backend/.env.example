# ─────────────────────────────────────────────────────────────────────────────
# Waliliens Backend — Environment Variables
# Copy this file to .env and fill in your values.
# Never commit .env to source control.
# ─────────────────────────────────────────────────────────────────────────────

# ── Server ────────────────────────────────────────────────────────────────────

# Runtime environment: development | production | test
NODE_ENV=development

# Port the HTTP server listens on
PORT=3001

# ── Database ──────────────────────────────────────────────────────────────────

# PostgreSQL connection string (docker-compose default shown)
DATABASE_URL=postgresql://waliliens:waliliens_dev_pw@localhost:5432/waliliens_db

# ── Redis ─────────────────────────────────────────────────────────────────────

# Redis connection URL (docker-compose default shown)
REDIS_URL=redis://localhost:6379

# ── JWT ───────────────────────────────────────────────────────────────────────
# Generate with: node -e "console.log(require('crypto').randomBytes(64).toString('hex'))"

# Secret for signing short-lived access tokens (15 min)
JWT_ACCESS_SECRET=REPLACE_ME_WITH_A_64_CHAR_RANDOM_HEX_STRING

# Secret for signing long-lived refresh tokens (7 days)
JWT_REFRESH_SECRET=REPLACE_ME_WITH_A_DIFFERENT_64_CHAR_RANDOM_HEX_STRING

# Access token lifetime (ms/seconds notation — e.g. "15m", "1h")
JWT_ACCESS_EXPIRES_IN=15m

# Refresh token lifetime
JWT_REFRESH_EXPIRES_IN=7d

# ── Email (Resend) ────────────────────────────────────────────────────────────
# Get your API key at: https://resend.com/api-keys

# Resend API key (must start with re_)
RESEND_API_KEY=re_YOUR_RESEND_API_KEY_HERE

# The "from" address shown to recipients (must be a verified domain in Resend)
EMAIL_FROM=noreply@waliliens.com

# Team inbox — receives new lead notifications
EMAIL_TO_TEAM=hello@waliliens.com

# ── CORS ──────────────────────────────────────────────────────────────────────

# Comma-separated list of allowed origins (no trailing slash)
# Development example:
ALLOWED_ORIGINS=http://localhost:5500,http://localhost:3000
# Production example:
# ALLOWED_ORIGINS=https://waliliens.com,https://www.waliliens.com

# ── Rate Limiting ─────────────────────────────────────────────────────────────

# Contact form: max 5 requests per IP per 15 minutes
RATE_LIMIT_CONTACT_WINDOW_MS=900000
RATE_LIMIT_CONTACT_MAX=5

# Per-email: max 3 submissions per email address per hour
RATE_LIMIT_EMAIL_WINDOW_MS=3600000
RATE_LIMIT_EMAIL_MAX=3

# Auth endpoints: max 10 attempts per IP per 15 minutes
RATE_LIMIT_AUTH_WINDOW_MS=900000
RATE_LIMIT_AUTH_MAX=10

# ── Optional: Slack Webhook ───────────────────────────────────────────────────
# Leave blank to disable. Set to activate team Slack notifications on new leads.
# SLACK_WEBHOOK_URL=https://hooks.slack.com/services/YOUR/WEBHOOK/URL

# ── Optional: Cloudflare Turnstile ───────────────────────────────────────────
# Leave blank to skip CAPTCHA verification. When set, every contact request must
# include a valid Turnstile token.
# Get your keys at: https://dash.cloudflare.com → Turnstile
#
# IMPORTANT: this secret key and the frontend's TURNSTILE_SITE_KEY
# (frontend/js/config.js) MUST come from the same Cloudflare Turnstile widget —
# a site key from one widget will never validate against another widget's
# secret key, and every submission will fail with CAPTCHA_FAILED. Set both
# together, or leave both blank to disable CAPTCHA consistently on both sides.
# TURNSTILE_SECRET_KEY=YOUR_TURNSTILE_SECRET_KEY_HERE

# ── Optional: Sentry Error Tracking ──────────────────────────────────────────
# Leave blank to disable. Set to forward errors to Sentry.
# SENTRY_DSN=https://YOUR_KEY@oXXXXXX.ingest.sentry.io/XXXXXXX

# ── Database Seeding (src/db/seed.ts, `npm run db:seed`) ─────────────────────
# Required — the seed script fails loudly if either is unset. Only used to
# hash the initial admin/viewer accounts on first run; re-running the seed
# against an existing database never resets an existing user's password.
SEED_ADMIN_PASSWORD=REPLACE_ME_WITH_A_STRONG_PASSWORD
SEED_VIEWER_PASSWORD=REPLACE_ME_WITH_A_DIFFERENT_STRONG_PASSWORD

# The seed script refuses to run at all when NODE_ENV=production unless this
# is explicitly set to "true". Leave unset/commented out everywhere except a
# genuine, deliberate one-off production seed.
# ALLOW_PROD_SEED=true
